<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title><%= title %> - Bhaccasyoniztas Beach Resort</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			<div id="header">
				<div id="logo">
					<a href="/"><img src="/images/logo.png" alt="LOGO" height="100" width="200"></a>
				</div>
				<div id="navigation">
					<ul>
						<li><a href="/">Home</a></li>
						<li><a href="/travel">Travel</a></li>
						<li><a href="/rooms">Rooms</a></li>
						<li><a href="/meals">Meals</a></li>
						<li><a href="/news">News</a></li>
						<li><a href="/about">About</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
				</div>
			</div>
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1><%= title %></h1>
							<ul id="sites">
								<% diveSites.forEach(site => { %>
									<li>
										<a href="/travel"><img src="<%= site.image %>" alt="Img"></a>
										<h2><%= site.name %></h2>
										<p><%= site.description1 %></p>
										<p><%= site.description2 %></p>
									</li>
								<% }) %>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div id="footer">
			<div>
				<ul class="navigation">
					<li><a href="/">Home</a></li>
					<li><a href="/travel">Travel</a></li>
					<li><a href="/rooms">Rooms</a></li>
					<li><a href="/meals">Meals</a></li>
					<li><a href="/news">News</a></li>
					<li><a href="/about">About</a></li>
					<li><a href="/contact">Contact</a></li>
				</ul>
				<div id="connect">
					<a href="http://pinterest.com/fwtemplates/" target="_blank" class="pinterest"></a>
					<a href="http://freewebsitetemplates.com/go/facebook/" target="_blank" class="facebook"></a>
					<a href="http://freewebsitetemplates.com/go/twitter/" target="_blank" class="twitter"></a>
					<a href="http://freewebsitetemplates.com/go/googleplus/" target="_blank" class="googleplus"></a>
				</div>
			</div>
			<p>© 2023 by BHACCASYONIZTAS BEACH RESORT. All Rights Reserved</p>
		</div>
	</div>
</body>
</html>
